<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>URL Shortener</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #f5f7ff, #eef2ff);
      color: #111827;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 650px;
      text-align: center;
    }

    .logo {
      width: 64px;
      height: 64px;
      margin: 0 auto 20px;
      border-radius: 16px;
      background: #4f46e5;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      box-shadow: 0 10px 25px rgba(79, 70, 229, 0.25);
    }

    h1 {
      font-size: 42px;
      margin-bottom: 12px;
      letter-spacing: -1px;
    }

    .subtitle {
      color: #6b7280;
      font-size: 17px;
      margin-bottom: 35px;
      line-height: 1.6;
    }

    .card {
      background: white;
      padding: 28px;
      border-radius: 18px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
    }

    .form {
      display: flex;
      gap: 10px;
    }

    .url-input {
      flex: 1;
      padding: 15px 16px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      font-size: 16px;
      outline: none;
      transition: border-color 0.2s;
    }

    .url-input:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    .shorten-btn {
      border: none;
      padding: 15px 22px;
      border-radius: 10px;
      background: #4f46e5;
      color: white;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      white-space: nowrap;
    }

    .shorten-btn:hover {
      background: #4338ca;
    }

    .shorten-btn:active {
      transform: scale(0.98);
    }

    .shorten-btn:disabled {
      background: #9ca3af;
      cursor: not-allowed;
    }

    .result {
      display: none;
      margin-top: 22px;
      padding: 18px;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 12px;
      text-align: left;
    }

    .result-label {
      font-size: 13px;
      color: #166534;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .result-row {
      display: flex;
      gap: 10px;
    }

    .short-url {
      flex: 1;
      padding: 12px;
      background: white;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      color: #2563eb;
      font-size: 15px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .copy-btn {
      border: none;
      padding: 0 18px;
      border-radius: 8px;
      background: #166534;
      color: white;
      cursor: pointer;
      font-weight: 600;
    }

    .error {
      display: none;
      margin-top: 15px;
      padding: 12px 15px;
      border-radius: 8px;
      background: #fef2f2;
      color: #b91c1c;
      font-size: 14px;
      text-align: left;
    }

    .info {
      margin-top: 25px;
      color: #9ca3af;
      font-size: 13px;
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 32px;
      }

      .form {
        flex-direction: column;
      }

      .shorten-btn {
        width: 100%;
      }

      .result-row {
        flex-direction: column;
      }

      .copy-btn {
        padding: 12px;
      }

      .card {
        padding: 20px;
      }
    }
  </style>

</head>

<body>

  <main class="container">

```
<div class="logo">
  🔗
</div>

<h1>Shorten Your URL</h1>

<p class="subtitle">
  Transform long URLs into short, easy-to-share links in seconds.
</p>

<div class="card">

  <form class="form" id="urlForm">

    <input
      type="url"
      id="urlInput"
      class="url-input"
      placeholder="https://example.com/your-long-url"
      required
    />

    <button
      type="submit"
      class="shorten-btn"
      id="shortenBtn"
    >
      Shorten URL
    </button>

  </form>

  <div class="error" id="errorMessage"></div>

  <div class="result" id="result">

    <div class="result-label">
      Your shortened URL
    </div>

    <div class="result-row">

      <input
        type="text"
        id="shortUrl"
        class="short-url"
        readonly
      />

      <button
        class="copy-btn"
        id="copyBtn"
        type="button"
      >
        Copy
      </button>

    </div>

  </div>

</div>

<div class="info">
  Fast • Simple • Shareable
</div>
```

  </main>

  <script>

    const form = document.getElementById("urlForm");
    const urlInput = document.getElementById("urlInput");
    const shortenBtn = document.getElementById("shortenBtn");

    const result = document.getElementById("result");
    const shortUrl = document.getElementById("shortUrl");

    const copyBtn = document.getElementById("copyBtn");
    const errorMessage = document.getElementById("errorMessage");


    form.addEventListener("submit", async (event) => {

      event.preventDefault();

      const url = urlInput.value.trim();

      if (!url) {
        showError("Please enter a URL.");
        return;
      }

      hideError();

      shortenBtn.disabled = true;
      shortenBtn.textContent = "Shortening...";

      result.style.display = "none";

      try {

        const response = await fetch("/url", {

          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify({
            url: url
          })

        });


        const data = await response.json();


        if (!response.ok) {
          throw new Error(
            data.message || "Unable to shorten URL."
          );
        }


        /*
         * Adjust this according to your API response.
         *
         * Example:
         * {
         *   id: "abc123"
         * }
         */

        const id = data.id || data.shortId;

        if (!id) {
          throw new Error("Short URL was not returned by the server.");
        }


        const generatedUrl =
          `${window.location.origin}/url/${id}`;


        shortUrl.value = generatedUrl;

        result.style.display = "block";


      } catch (error) {

        console.error(error);

        showError(
          error.message || "Something went wrong. Please try again."
        );

      } finally {

        shortenBtn.disabled = false;
        shortenBtn.textContent = "Shorten URL";

      }

    });


    copyBtn.addEventListener("click", async () => {

      try {

        await navigator.clipboard.writeText(
          shortUrl.value
        );

        copyBtn.textContent = "Copied!";

        setTimeout(() => {
          copyBtn.textContent = "Copy";
        }, 1500);

      } catch (error) {

        shortUrl.select();
        document.execCommand("copy");

        copyBtn.textContent = "Copied!";

        setTimeout(() => {
          copyBtn.textContent = "Copy";
        }, 1500);

      }

    });


    function showError(message) {

      errorMessage.textContent = message;
      errorMessage.style.display = "block";

    }


    function hideError() {

      errorMessage.textContent = "";
      errorMessage.style.display = "none";

    }

  </script>

</body>
</html>
